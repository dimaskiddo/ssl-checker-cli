{
  "name": "ssl-checker-cli",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "latest",
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "scripts": {
    "check-ssl": "bun --smol index.ts",
    "clean": "bun run build:clean && bun run vendor:clean",
    "release": "bun install && bun .scripts/release.ts",
    "build": "bun run build:clean && bun build --compile --compile-exec-argv=\"--smol\" --minify index.ts --outfile dist/ssl-checker",
    "build:all": "bun run build:clean && bun run build:linux-64-bit && bun run build:linux-arm64 && bun run build:macos-64-bit && bun run build:macos-arm64 && bun run build:win-64-bit",
    "build:linux-64-bit": "bun build --compile --compile-exec-argv=\"--smol\" --minify --target=bun-linux-x64 index.ts --outfile dist/ssl-checker-linux-64-bit",
    "build:linux-arm64": "bun build --compile --compile-exec-argv=\"--smol\" --minify --target=bun-linux-arm64 index.ts --outfile dist/ssl-checker-linux-arm64",
    "build:macos-64-bit": "bun build --compile --compile-exec-argv=\"--smol\" --minify --target=bun-darwin-x64 index.ts --outfile dist/ssl-checker-macos-64-bit",
    "build:macos-arm64": "bun build --compile --compile-exec-argv=\"--smol\" --minify --target=bun-darwin-arm64 index.ts --outfile dist/ssl-checker-macos-arm64",
    "build:win-64-bit": "bun build --compile --compile-exec-argv=\"--smol\" --minify --target=bun-windows-x64 index.ts --outfile dist/ssl-checker-win-64-bit.exe",
    "build:clean": "rm -rf dist",
    "vendor:clean": "rm -rf node_modules"
  }
}